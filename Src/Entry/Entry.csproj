<Project Sdk="Microsoft.NET.Sdk.Razor">
	
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <PublishAot>true</PublishAot>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <OpenHarmonyTarget>true</OpenHarmonyTarget>
	  <OpenHarmonyApiLevel Condition="'$(OpenHarmonyApiLevel)' == ''">15</OpenHarmonyApiLevel>
	  <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	  <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
  </PropertyGroup>

	<Import Project="Properties\PublishProfiles\$(PublishProfile).pubxml"
			Condition="'$(PublishProfile)' != '' and Exists('Properties\PublishProfiles\$(PublishProfile).pubxml')" />
	<PropertyGroup>
		<!-- The SDK imports PublishProfile during target execution. The profile
		     is preloaded above so custom runtime targets see RID/ABI at evaluation. -->
		<WebPublishProfileFile Condition="'$(PublishProfile)' != '' and Exists('Properties\PublishProfiles\$(PublishProfile).pubxml')">$(MSBuildProjectDirectory)\Properties\PublishProfiles\__preloaded__.pubxml</WebPublishProfileFile>
		<_OpenHarmonyBuildAbi Condition="'$(OpenHarmonyAbi)' == ''">unknown</_OpenHarmonyBuildAbi>
		<_OpenHarmonyBuildAbi Condition="'$(OpenHarmonyAbi)' != ''">$(OpenHarmonyAbi)</_OpenHarmonyBuildAbi>
		<OpenHarmonyRuntimeSourceCommit>76bde136efafd0e193234e38d169752b93e3bce6</OpenHarmonyRuntimeSourceCommit>
		<OpenHarmonyRuntimePackageCommit>ee65d55</OpenHarmonyRuntimePackageCommit>
		<OpenHarmonyBindingsCommit>2b68d3c</OpenHarmonyBindingsCommit>
		<PublishAotCrossCommit>94e69fb</PublishAotCrossCommit>
		<OpenHarmonySampleCommit Condition="'$(OpenHarmonySampleCommit)' == ''">unknown</OpenHarmonySampleCommit>
		<OpenHarmonyEvidenceRunId Condition="'$(OpenHarmonyEvidenceRunId)' == ''">unknown</OpenHarmonyEvidenceRunId>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyApiLevel</_Parameter1>
			<_Parameter2>$(OpenHarmonyApiLevel)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyAbi</_Parameter1>
			<_Parameter2>$(_OpenHarmonyBuildAbi)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyRuntimeSourceCommit</_Parameter1>
			<_Parameter2>$(OpenHarmonyRuntimeSourceCommit)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyRuntimePackageCommit</_Parameter1>
			<_Parameter2>$(OpenHarmonyRuntimePackageCommit)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyBindingsCommit</_Parameter1>
			<_Parameter2>$(OpenHarmonyBindingsCommit)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>PublishAotCrossCommit</_Parameter1>
			<_Parameter2>$(PublishAotCrossCommit)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonySampleCommit</_Parameter1>
			<_Parameter2>$(OpenHarmonySampleCommit)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenHarmonyEvidenceRunId</_Parameter1>
			<_Parameter2>$(OpenHarmonyEvidenceRunId)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<Target Name="MarkOpenHarmonyPublishProfileImported"
			BeforeTargets="PrepareForPublish"
			Condition="'$(PublishProfile)' != '' and Exists('Properties\PublishProfiles\$(PublishProfile).pubxml')">
		<PropertyGroup>
			<PublishProfileImported>true</PublishProfileImported>
		</PropertyGroup>
	</Target>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ThirdParty\OpenHarmony.NDK.Bindings\OpenHarmony.NDK.Bindings\OpenHarmony.NDK.Bindings.csproj" />
		<ProjectReference Include="..\BlazorApp\BlazorApp.csproj" />
	</ItemGroup>

	<Import Project="../../ThirdParty/PublishAotCross/package/OpenHarmony.NET.PublishAotCross.targets" />
	<Import Project="../../ThirdParty/OpenHarmony.NET.Runtime/runtime.targets" />

	<ItemGroup>
		<RdXmlFile Include="rd.xml" />
	</ItemGroup>

	<Target Name="CopywwwrootAfterBuild" AfterTargets="Publish">
		<PropertyGroup>
			<DestinationDir Condition="$(RuntimeIdentifier.Contains('linux-musl-arm64'))">../../OHOS_Project/AppScope/resources/resfile/wwwroot/arm64-v8a/</DestinationDir>
			<DestinationDir Condition="$(RuntimeIdentifier.Contains('linux-musl-x64'))">../../OHOS_Project/AppScope/resources/resfile/wwwroot/x86_64/</DestinationDir>
		</PropertyGroup>

		<MakeDir Directories="$(DestinationDir)" Condition="!Exists('$(DestinationDir)')" />

		<ItemGroup>
			<wwwrootFiles Include="$(PublishDir)wwwroot\**\*.*" />
		</ItemGroup>
		<Message Importance="high" Text="Copying wwwroot files to $(DestinationDir)" />

		<Copy SourceFiles="@(wwwrootFiles)" DestinationFiles="@(wwwrootFiles->'$(DestinationDir)%(RecursiveDir)%(Filename)%(Extension)')" />

		<RemoveDir Directories="$(PublishDir)wwwroot" />
	</Target>
</Project>
