<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <OpenHarmonyTarget>true</OpenHarmonyTarget>
    <OpenHarmonyApiLevel>26</OpenHarmonyApiLevel>
    <OpenHarmonyAbi Condition="'$(OpenHarmonyAbi)' == ''">arm64-v8a</OpenHarmonyAbi>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'arm64-v8a'">linux-musl-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(OpenHarmonyAbi)' == 'x86_64'">linux-musl-x64</RuntimeIdentifier>
    <PublishDir Condition="'$(OpenHarmonyAbi)' == 'arm64-v8a'">../../OHOS_Project/entry/libs/arm64-v8a</PublishDir>
    <PublishDir Condition="'$(OpenHarmonyAbi)' == 'x86_64'">../../OHOS_Project/entry/libs/x86_64</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
